# External message transport selected by TransportEnvironmentConfig.
# NONE keeps the direct in-process bus only.
ABC_TRADING_TRANSPORT=NONE

# Redis Streams deployment (used when ABC_TRADING_TRANSPORT=REDIS).
ABC_TRADING_REDIS_HOST=127.0.0.1
ABC_TRADING_REDIS_PORT=6379
ABC_TRADING_REDIS_USERNAME=
ABC_TRADING_REDIS_PASSWORD=
ABC_TRADING_REDIS_SSL=false
ABC_TRADING_REDIS_STREAM=stream
ABC_TRADING_REDIS_TIMEOUT_MS=2000
ABC_TRADING_REDIS_BLOCK_MS=1000
ABC_TRADING_REDIS_BATCH_SIZE=100
ABC_TRADING_REDIS_MAX_RETRIES=3
ABC_TRADING_REDIS_RETRY_DELAY_MS=100

# Aeron deployment (used when ABC_TRADING_TRANSPORT=AERON).
ABC_TRADING_AERON_CHANNEL=aeron:ipc
ABC_TRADING_AERON_STREAM_ID=1001
# true starts an embedded MediaDriver; false connects to an existing driver directory.
ABC_TRADING_AERON_EMBEDDED=true
ABC_TRADING_AERON_DIRECTORY=
ABC_TRADING_AERON_FRAGMENT_LIMIT=10
ABC_TRADING_AERON_MAX_RETRIES=100
ABC_TRADING_AERON_RETRY_DELAY_MS=1
